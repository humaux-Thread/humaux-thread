      "x-humaux-operation": {
        "operation_key": "memory.get",
        "required_scope": "context:read",
        "feature_key": "mcp.billable_operations.per_period",
        "meter_kind": "ordinary1"
      },
      "properties": {
        "action": {
          "const": "get"
        },
        "memory_id": {
          "type": "string",
          "format": "uuid"
        },
        "note_id": {
          "description": "ADR-0067 D-J2: read the note's current version (its head), instead of memory_id. Exactly one of memory_id / note_id; neither ever falls back to the other. A forgotten, tombstoned or otherwise unreadable head is NOT_FOUND.",
          "type": "string",
          "format": "uuid"
        },
        "workspace_id": {
          "type": "string",
          "format": "uuid"
        },
        "include_history": {
          "description": "ADR-0067 D-H: true returns the exact version asked for even when it is superseded (never its successor), with status, superseded_by (only when readable) and provenance. Revoked, expired, forgotten and tombstoned versions stay NOT_FOUND. Default false: the response is unchanged and a superseded id is NOT_FOUND. With note_id it reads the head.",
          "type": "boolean"
        }
      },
      "required": [
        "action"
      ],
      "oneOf": [
        {
          "required": [
            "memory_id"
          ]
        },
        {
          "required": [
            "note_id"
          ]
        }
      ],
      "additionalProperties": false
    },
    {
