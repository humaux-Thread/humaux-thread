              "intensity",
              "confidence"
            ],
            "additionalProperties": false
          },
          "maxItems": 16
        },
        "subject_keys": {
          "description": "§6.1.3 rule 2: exact trusted external keys resolved through the tenant's subject_keys registry (kind is the closed SubjectKeyKind set). Unknown key is INVALID_INPUT.",
          "type": "array",
          "items": {
            "type": "object",
