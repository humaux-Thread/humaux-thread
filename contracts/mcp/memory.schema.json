                  "JOY",
                  "SADNESS",
                  "ANGER",
                  "FEAR",
                  "DISGUST",
                  "SURPRISE",
                  "AFFECTION",
                  "ANXIETY",
                  "FRUSTRATION",
                  "CALM",
                  "EXCITEMENT",
                  "RELIEF"
                ]
              },
              "valence": {
                "type": "integer",
                "minimum": -10000,
                "maximum": 10000
              },
              "arousal": {
                "type": "integer",
                "minimum": -10000,
                "maximum": 10000
              },
              "dominance": {
                "type": "integer",
                "minimum": -10000,
                "maximum": 10000
              },
              "intensity": {
                "type": "integer",
                "minimum": 0,
                "maximum": 10000
              },
              "confidence": {
                "type": "integer",
                "minimum": 0,
                "maximum": 10000
              },
              "target_subject_id": {
                "type": "string",
                "format": "uuid"
              },
              "target_subject_key": {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 32
                  },
                  "value": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 512
                  }
                },
                "required": [
                  "kind",
                  "value"
                ],
                "additionalProperties": false
              },
              "target_scope": {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "enum": [
                      "WORKSPACE",
                      "REPOSITORY",
                      "TASK",
                      "RUN",
                      "AGENT"
                    ]
                  },
                  "id": {
                    "type": "string",
