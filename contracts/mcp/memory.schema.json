            "type": "string",
            "enum": [
              "active",
              "superseded"
            ]
          },
          "minItems": 1,
          "maxItems": 2,
          "uniqueItems": true
        },
        "archive": {
          "description": "ADR-0067 D-J2: exclude (default) leaves archived versions out, only searches just them, include searches both; a cursor is bound to the selection.",
