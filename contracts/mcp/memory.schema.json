          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "candidates": {
          "type": "boolean"
        },
        "subjects": {
          "description": "§6.1.3 (ADR-0028): true lists the caller's tenant's registered subjects (with keys and roles) instead of memories; another tenant's registry is invisible under RLS.",
          "type": "boolean"
        },
        "subject_id": {
          "description": "§6.1.3 (ADR-0028 D-D): restrict the exact enumeration predicate to memories linked to this subject (never a post-filter; a cursor is bound to its filter).",
          "type": "string",
          "format": "uuid"
        },
        "note_kinds": {
          "description": "ADR-0067 D-G: restrict the exact enumeration predicate (and its census) to notes of these kinds; a cursor is bound to its filter.",
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "rejected",
              "decision",
              "fix",
              "problem",
              "lesson",
              "research",
              "preference",
              "state",
              "note",
              "event",
              "plan",
              "episode"
            ]
          },
          "minItems": 1,
          "maxItems": 12,
          "uniqueItems": true
        },
        "since": {
          "description": "ADR-0067 D-G: inclusive lower bound on occurred_at (RFC 3339); a memory with no occurred_at is outside any bounded window.",
          "type": "string",
          "format": "date-time"
        },
        "until": {
          "description": "ADR-0067 D-G: exclusive upper bound on occurred_at (RFC 3339); since must be earlier than until.",
          "type": "string",
          "format": "date-time"
        },
        "statuses": {
          "description": "ADR-0067 D-J2: the lifecycle statuses the exact predicate (and its census) admits; default [\"active\"]. revoked and expired are never readable (L-6). When given, every item carries its status; a cursor is bound to the selection.",
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "active",
              "superseded"
            ]
          },
          "minItems": 1,
          "maxItems": 2,
          "uniqueItems": true
        },
        "archive": {
          "description": "ADR-0067 D-J2: exclude (default) leaves archived versions out, only lists just them, include lists both; a cursor is bound to the selection.",
          "type": "string",
          "enum": [
            "exclude",
            "only",
            "include"
          ]
        },
        "note_id": {
          "description": "ADR-0067 D-J2: restrict the exact predicate to the versions of this note; with statuses [\"active\",\"superseded\"] and archive include it is the note's version list. A cursor is bound to it.",
          "type": "string",
          "format": "uuid"
        }
      },
      "required": [
        "action"
      ],
      "additionalProperties": false
    },
