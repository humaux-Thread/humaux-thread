# deploy/pgbackrest/humaux-backup.crontab — the host crontab of a bundle node (ADR-0066 D-H): the card-37 schedule
# (backup daily 00:30 UTC, restore drill Wednesday 03:00) run through the profile-gated `dr` one-shot of prod.yml.
# Install as the operator (docker rights) after setting the three variables deploy/release/compose.sh requires for
# this node. The deploy checkout is NOT written here: each line reads HUMAUX_NODE_DEPLOY_DIR from node.env at run
# time, so an upgrade that installs checkout-<tag>/ and points node.env at it (runbook §R) moves the scheduled
# backup and drill with it — nothing to re-install (ADR-0066 review fix 9, PR #2 Codex P1). No value here is a secret.
PATH=/usr/local/bin:/usr/bin:/bin
HUMAUX_NODE_SIZING=a5
HUMAUX_NODE_DIR=/srv/humaux-node
HUMAUX_NODE_PROJECT=humaux-node
30 0 * * * D=$(sed -n 's/^HUMAUX_NODE_DEPLOY_DIR=//p' "$HUMAUX_NODE_DIR/node.env" | tail -n 1); sh "$D/release/compose.sh" run --rm -T dr backup run >> "$HUMAUX_NODE_DIR/evidence/cron.log" 2>&1
0 3 * * 3 D=$(sed -n 's/^HUMAUX_NODE_DEPLOY_DIR=//p' "$HUMAUX_NODE_DIR/node.env" | tail -n 1); sh "$D/release/compose.sh" run --rm -T dr restore drill --evidence "$HUMAUX_NODE_DIR/evidence/drill-$(date -u +\%Y\%m\%d).json" >> "$HUMAUX_NODE_DIR/evidence/cron.log" 2>&1
