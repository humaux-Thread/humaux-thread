# deploy/env/providers.env.example — the provider values runbook v2 §3 reads on a node (ADR-0066 S7): the embedding
# provider of `deploy-init` and of every onboarded tenant, and the reasoning route the two smoke tenants register.
# On a node: copy to $HUMAUX_NODE_DIR/providers.env and set every value. No secret lives here: keys are in
# $HUMAUX_SECRETS_DIR (retrieval-worker.secret.env: DASHSCOPE_API_KEY; private-worker.secret.env: the variable named
# by HUMAUX_NODE_ROUTE_KEY_ENV, the egress recipients and regions). Read by steps O1-O4 with `sed -n 's/^KEY=//p'`:
# one KEY=VALUE per line, no quotes, no spaces around `=`.
# Embedding provider (§19 frozen: DashScope text-embedding-v4 / 1024) and the deployment admission tiers (§0117).
HUMAUX_NODE_EMBEDDING_PROVIDER=dashscope
HUMAUX_NODE_EMBEDDING_REGION=cn-beijing
HUMAUX_NODE_EMBEDDING_TPM=100000000
HUMAUX_NODE_EMBEDDING_RPM=100000
# The smoke tenants' own TENANT tier (runbook §3.0).
HUMAUX_NODE_SMOKE_TENANT_TPM=1000000
HUMAUX_NODE_SMOKE_TENANT_RPM=10000
# The smoke tenants' reasoning route (ADR-0060 D-H): the values `reasoning register` declares. These are the
# rehearsal's MiniMax lane (docs/ops/rehearse.sh); the egress processor id is the recipient uuid this node mints for
# the vendor/region and also lists in HUMAUX_PRIVATE_WORKER_EGRESS_RECIPIENTS (step P2 checks that).
HUMAUX_NODE_ROUTE_PROVIDER_ID=minimax
HUMAUX_NODE_ROUTE_MODEL=MiniMax-M3
HUMAUX_NODE_ROUTE_MODEL_REVISION=caps-REASONING_SPLIT.STRUCTURED_OUTPUT.TEXT.TOOL_CALLS
HUMAUX_NODE_ROUTE_CAPABILITIES=TEXT,STRUCTURED_OUTPUT,TOOL_CALLS,REASONING_SPLIT
HUMAUX_NODE_ROUTE_REQUEST_EXTRAS={"reasoning_split":true}
HUMAUX_NODE_ROUTE_ACCOUNT_REF=node-minimax
HUMAUX_NODE_ROUTE_ENDPOINT=https://api.minimaxi.com/v1/chat/completions
HUMAUX_NODE_ROUTE_REGION=cn-shanghai
HUMAUX_NODE_ROUTE_SERVICE_TIER=standard
HUMAUX_NODE_ROUTE_EGRESS_PROCESSOR_ID=00000000-0000-4000-8000-000000000004
# The NAME of the variable in private-worker.secret.env that holds the provider key (step O4 maps both smoke
# tenants' credential references to it; one vendor account, ADR-0060 D-J).
HUMAUX_NODE_ROUTE_KEY_ENV=MINIMAX_API_KEY
# How long the operator attestation of the smoke routes is valid (seconds); traffic renews it (§10.4).
HUMAUX_NODE_ROUTE_ATTEST_VALID_SECS=86400
