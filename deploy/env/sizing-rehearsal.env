# deploy/env/sizing-rehearsal.env — container ceilings for the clean-node rehearsal on the dev Mac (Docker Desktop VM)
# of deploy/compose/prod.yml (ADR-0066 D-E, D-G, §5). Same key set as sizing-a5.env (gate c39_budget_sums); only the
# numbers differ. *_MEM is MiB (mem_limit = memswap_limit), *_CPUS a ceiling, *_PIDS pids_limit. Sum 3908 MiB of
# ceilings; the expected working set is about 1.0-1.2 GiB (D-E, E-1).
# Every number in this file: dev-host start value, A5 re-measure required (ADR-0066 R-10, L-1). Secret-free.
# The profile name: `dr` loads this file again as an env_file (../env/sizing-${HUMAUX_NODE_SIZING}.env, D-H).
HUMAUX_NODE_SIZING=rehearsal
HUMAUX_SIZE_PG_MEM=1024
HUMAUX_SIZE_PG_CPUS=1.0
HUMAUX_SIZE_PG_PIDS=256
HUMAUX_SIZE_QDRANT_MEM=384
HUMAUX_SIZE_QDRANT_CPUS=0.5
HUMAUX_SIZE_QDRANT_PIDS=128
# The floor `cargo xtask deploy-env` computes for the query-embedding cache values/gateway.env enables (M12 D5, Baseline §51,
# ADR-0076): cache + moka overhead + gateway working set; 256 MiB held the cache's default size alone.
HUMAUX_SIZE_GATEWAY_MEM=256
HUMAUX_SIZE_GATEWAY_CPUS=1.0
HUMAUX_SIZE_GATEWAY_PIDS=128
HUMAUX_SIZE_RETRIEVAL_RPC_MEM=192
HUMAUX_SIZE_RETRIEVAL_RPC_CPUS=0.5
HUMAUX_SIZE_RETRIEVAL_RPC_PIDS=128
HUMAUX_SIZE_RETRIEVAL_SERVE_MEM=192
HUMAUX_SIZE_RETRIEVAL_SERVE_CPUS=0.5
HUMAUX_SIZE_RETRIEVAL_SERVE_PIDS=128
HUMAUX_SIZE_PRIVATE_RPC_MEM=192
HUMAUX_SIZE_PRIVATE_RPC_CPUS=0.5
HUMAUX_SIZE_PRIVATE_RPC_PIDS=128
HUMAUX_SIZE_PRIVATE_DISTILL_MEM=192
HUMAUX_SIZE_PRIVATE_DISTILL_CPUS=0.5
HUMAUX_SIZE_PRIVATE_DISTILL_PIDS=128
HUMAUX_SIZE_CONSOLIDATION_MEM=128
HUMAUX_SIZE_CONSOLIDATION_CPUS=0.25
HUMAUX_SIZE_CONSOLIDATION_PIDS=64
HUMAUX_SIZE_MAINTENANCE_SERVE_MEM=128
HUMAUX_SIZE_MAINTENANCE_SERVE_CPUS=0.25
HUMAUX_SIZE_MAINTENANCE_SERVE_PIDS=64
HUMAUX_SIZE_MAINTENANCE_HEALTH_MEM=128
HUMAUX_SIZE_MAINTENANCE_HEALTH_CPUS=0.25
HUMAUX_SIZE_MAINTENANCE_HEALTH_PIDS=64
HUMAUX_SIZE_PROMETHEUS_MEM=256
HUMAUX_SIZE_PROMETHEUS_CPUS=0.25
HUMAUX_SIZE_PROMETHEUS_PIDS=128
HUMAUX_SIZE_ALERTMANAGER_MEM=64
HUMAUX_SIZE_ALERTMANAGER_CPUS=0.1
HUMAUX_SIZE_ALERTMANAGER_PIDS=32
HUMAUX_SIZE_OTEL_MEM=128
HUMAUX_SIZE_OTEL_CPUS=0.1
HUMAUX_SIZE_OTEL_PIDS=64
HUMAUX_SIZE_NETNS_MEM=16
HUMAUX_SIZE_NETNS_CPUS=0.05
HUMAUX_SIZE_NETNS_PIDS=16
# ops / migrate / dr / admin: one at a time (runbook rule), so one budget line.
HUMAUX_SIZE_ONESHOT_MEM=256
HUMAUX_SIZE_ONESHOT_CPUS=0.5
HUMAUX_SIZE_ONESHOT_PIDS=128
# §67.2 peak parse-sandbox: budget line only (§4.3 object not delivered, ADR-0066 D-B); nothing reserved on the Mac.
HUMAUX_SIZE_PARSE_SANDBOX_PEAK_MEM=0
# alert-sink (profile `rehearsal`): the Alertmanager webhook receiver of the alert drill.
HUMAUX_SIZE_ALERT_SINK_MEM=64
HUMAUX_SIZE_ALERT_SINK_CPUS=0.1
HUMAUX_SIZE_ALERT_SINK_PIDS=32
# PostgreSQL: the sizing conf mounted at /etc/humaux/pg-sizing.conf (D-G) and its /dev/shm.
HUMAUX_PG_SIZING_CONF=../postgres/sizing-rehearsal.conf
HUMAUX_PG_SHM_SIZE=256m
# The card-37 restore drill (deploy/compose/drill.yml), run by `dr` beside production; its own caps.
HUMAUX_DRILL_PG_MEM_LIMIT=512m
HUMAUX_DRILL_QDRANT_MEM_LIMIT=512m
HUMAUX_DRILL_CPUS=0.5
# ADR-0066 R-2: the release build runs inside `docker run --memory ${HUMAUX_BUILD_MEM_MIB}m` in the shared Docker VM.
HUMAUX_BUILD_MEM_MIB=2560
HUMAUX_BUILD_CPUS=2
CARGO_BUILD_JOBS=2
