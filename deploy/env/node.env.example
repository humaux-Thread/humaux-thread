# deploy/env/node.env.example — the per-node interpolation values of deploy/compose/prod.yml (ADR-0066 D-C, D-F, D-J).
# On a node: copy to $HUMAUX_NODE_DIR/node.env (0600 is not needed: no secret here) and set every value; every path
# must then be ABSOLUTE (`dr` mounts the deploy dir and the secrets dir at the same path, D-H).
# deploy/release/compose.sh passes it as the second --env-file after deploy/env/sizing-$HUMAUX_NODE_SIZING.env.
# As checked in, it is what the chain gates c39_compose_config / c39_deploy_check_live / check-compose.sh interpolate:
# HUMAUX_SECRETS_DIR points at the placeholder dir deploy/env/secret-fixture (names only, empty values), so
# `docker compose config` resolves every env_file in a clean checkout and a fixture can never carry a secret.
# Relative values resolve against deploy/compose/ (the project directory).
# The compose project name; also HUMAUX_MAINTENANCE_BACKUP_PROJECT of `dr`.
HUMAUX_NODE_PROJECT=humaux-node
# Images: the release tag build.sh printed (humaux-<target>:<crate_version>-<sha12>) and the card-37 PostgreSQL image
# build.sh builds beside them (humaux-pg:<same tag>).
HUMAUX_IMAGE_TAG=0.1.0-000000000000
HUMAUX_PG_IMAGE=humaux-pg:0.1.0-000000000000
# Directories (absolute on a node): the deploy checkout, the secrets dir (0700, files 0600, operator-owned, outside
# git), the evidence and releases dirs, the rendered observability configs (deploy/prometheus/render.sh), the
# Alertmanager webhook URL files, and the mount point of the pgBackRest repository filesystem (card 37).
HUMAUX_NODE_DEPLOY_DIR=..
# This file's own path: `dr` loads it as an env_file so its compose CLI can interpolate prod.yml (D-H).
HUMAUX_NODE_ENV_FILE=../env/node.env.example
HUMAUX_SECRETS_DIR=../env/secret-fixture
HUMAUX_NODE_EVIDENCE_DIR=/srv/humaux-node/evidence
HUMAUX_NODE_RELEASES_DIR=/srv/humaux-node/releases
HUMAUX_OBSERVABILITY_RENDERED_DIR=/srv/humaux-node/rendered
HUMAUX_ALERTMANAGER_URL_DIR=/srv/humaux-node/alert-urls
HUMAUX_PG_REPO_DIR=/srv/humaux-repo
# Network (D-F): the project bridge (10.239.39.0/24 is free on the dev Mac and on A5, F16), the netns anchor's and
# Qdrant's fixed addresses, and the loopback-published host ports.
HUMAUX_NODE_SUBNET=10.239.39.0/24
HUMAUX_NODE_NETNS_IP=10.239.39.10
HUMAUX_NODE_QDRANT_IP=10.239.39.20
HUMAUX_NODE_GATEWAY_HOST_PORT=8080
HUMAUX_PG_PORT=5432
# '*' in service; `restore pitr` overrides it with '' (socket only) while it quarantines roles (card 37 D-U).
HUMAUX_PG_LISTEN_ADDRESSES=*
# Node identity (non-secret, per node): this Cell's UUID, the retrieval worker's egress processor id and the
# reasoning domain the gateway's remember path writes under (runbook v2 §2 sets them; uuidgen / onboarding output).
HUMAUX_NODE_CELL_ID=00000000-0000-4000-8000-000000000001
HUMAUX_NODE_RETRIEVAL_EGRESS_PROCESSOR_ID=00000000-0000-4000-8000-000000000002
HUMAUX_NODE_REMEMBER_REASONING_DOMAIN_ID=00000000-0000-4000-8000-000000000003
