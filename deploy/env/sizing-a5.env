# deploy/env/sizing-a5.env — container ceilings for the A5 node (§67.2: 4 vCPU / 24 GB ARM) of deploy/compose/prod.yml
# (ADR-0066 D-E, D-G). Read by docker compose through ${HUMAUX_SIZE_*:?} interpolation (deploy/release/compose.sh
# --env-file) and by deploy/release/budget_sums.sh. sizing-a5.env and sizing-rehearsal.env carry the SAME key set
# (gate c39_budget_sums); only the numbers differ. *_MEM is MiB (mem_limit = memswap_limit: no swap), *_CPUS is a
# ceiling (the sum over-commits 4 vCPU on purpose; the §67.2 concurrency limits are the real CPU governors, D-E),
# *_PIDS is pids_limit. Budget: MemTotal - sum(*_MEM) - the drill's HUMAUX_DRILL_*_MEM_LIMIT >= 4096 MiB at the 22 GiB
# band floor (22528 - 16528 - 1536 = 4464; PR #2 round 8 moved 1.5 GiB of pg page cache to the concurrent drill).
# Every number in this file: dev-host start value, A5 re-measure required (ADR-0066 R-10, L-1; O-1 stays open until
# deploy/release/a5_load_remeasure.sh passes on A5). Secret-free.
# The profile name: `dr` loads this file again as an env_file (../env/sizing-${HUMAUX_NODE_SIZING}.env, D-H).
HUMAUX_NODE_SIZING=a5
HUMAUX_SIZE_PG_MEM=7168
HUMAUX_SIZE_PG_CPUS=2.0
HUMAUX_SIZE_PG_PIDS=512
HUMAUX_SIZE_QDRANT_MEM=3072
HUMAUX_SIZE_QDRANT_CPUS=1.0
HUMAUX_SIZE_QDRANT_PIDS=256
HUMAUX_SIZE_GATEWAY_MEM=1024
HUMAUX_SIZE_GATEWAY_CPUS=2.0
HUMAUX_SIZE_GATEWAY_PIDS=256
HUMAUX_SIZE_RETRIEVAL_RPC_MEM=512
HUMAUX_SIZE_RETRIEVAL_RPC_CPUS=1.0
HUMAUX_SIZE_RETRIEVAL_RPC_PIDS=256
HUMAUX_SIZE_RETRIEVAL_SERVE_MEM=512
HUMAUX_SIZE_RETRIEVAL_SERVE_CPUS=1.0
HUMAUX_SIZE_RETRIEVAL_SERVE_PIDS=256
HUMAUX_SIZE_PRIVATE_RPC_MEM=512
HUMAUX_SIZE_PRIVATE_RPC_CPUS=1.0
HUMAUX_SIZE_PRIVATE_RPC_PIDS=256
HUMAUX_SIZE_PRIVATE_DISTILL_MEM=512
HUMAUX_SIZE_PRIVATE_DISTILL_CPUS=1.0
HUMAUX_SIZE_PRIVATE_DISTILL_PIDS=256
HUMAUX_SIZE_CONSOLIDATION_MEM=256
HUMAUX_SIZE_CONSOLIDATION_CPUS=0.5
HUMAUX_SIZE_CONSOLIDATION_PIDS=128
HUMAUX_SIZE_MAINTENANCE_SERVE_MEM=256
HUMAUX_SIZE_MAINTENANCE_SERVE_CPUS=0.5
HUMAUX_SIZE_MAINTENANCE_SERVE_PIDS=128
HUMAUX_SIZE_MAINTENANCE_HEALTH_MEM=256
HUMAUX_SIZE_MAINTENANCE_HEALTH_CPUS=0.5
HUMAUX_SIZE_MAINTENANCE_HEALTH_PIDS=128
HUMAUX_SIZE_PROMETHEUS_MEM=1024
HUMAUX_SIZE_PROMETHEUS_CPUS=0.5
HUMAUX_SIZE_PROMETHEUS_PIDS=256
HUMAUX_SIZE_ALERTMANAGER_MEM=128
HUMAUX_SIZE_ALERTMANAGER_CPUS=0.25
HUMAUX_SIZE_ALERTMANAGER_PIDS=64
HUMAUX_SIZE_OTEL_MEM=256
HUMAUX_SIZE_OTEL_CPUS=0.25
HUMAUX_SIZE_OTEL_PIDS=128
HUMAUX_SIZE_NETNS_MEM=16
HUMAUX_SIZE_NETNS_CPUS=0.05
HUMAUX_SIZE_NETNS_PIDS=16
# ops / migrate / dr / admin: one at a time (runbook rule), so one budget line.
HUMAUX_SIZE_ONESHOT_MEM=512
HUMAUX_SIZE_ONESHOT_CPUS=1.0
HUMAUX_SIZE_ONESHOT_PIDS=256
# §67.2 peak parse-sandbox: a budget line with no service (§4.3 object not delivered, ADR-0066 D-B), reserved now so
# shipping it later does not move the reserve.
HUMAUX_SIZE_PARSE_SANDBOX_PEAK_MEM=512
# alert-sink exists only in the `rehearsal` profile; never started on A5 (0 keeps the key sets equal).
HUMAUX_SIZE_ALERT_SINK_MEM=0
HUMAUX_SIZE_ALERT_SINK_CPUS=0.1
HUMAUX_SIZE_ALERT_SINK_PIDS=32
# PostgreSQL: the sizing conf mounted at /etc/humaux/pg-sizing.conf (D-G) and its /dev/shm.
HUMAUX_PG_SIZING_CONF=../postgres/sizing-a5.conf
HUMAUX_PG_SHM_SIZE=1g
# The card-37 restore drill (deploy/compose/drill.yml), run by `dr` beside production; its own caps, counted in the
# budget (budget_sums.sh). An OOM inside the drill kills a drill container, never production (drill.yml header).
HUMAUX_DRILL_PG_MEM_LIMIT=1g
HUMAUX_DRILL_QDRANT_MEM_LIMIT=512m
HUMAUX_DRILL_CPUS=1.0
# ADR-0066 R-2: the release build runs inside `docker run --memory ${HUMAUX_BUILD_MEM_MIB}m` (A5's build host).
HUMAUX_BUILD_MEM_MIB=8192
HUMAUX_BUILD_CPUS=4
CARGO_BUILD_JOBS=4
