# deploy/env/values/maintenance.env — services: maintenance-health (health serve), maintenance-serve (--serve), and the
# one-shots ops, migrate and dr (profile ops).
# Non-secret BUNDLE CONSTANTS (identical on every node), loaded by deploy/compose/prod.yml as the first env_file of
# the service(s) below (ADR-0066 D-C, D-J). Never here: a DSN, password, key, pepper or credential map (those are in
# $HUMAUX_SECRETS_DIR/<process>.secret.env, 0600, outside git, written by deploy/release/render-secrets.sh); a node
# value (cell id, egress processor id, addresses, paths: prod.yml `environment:` from node.env); a DEV_ONLY_KEYS entry
# (the dev-only same-uid allowance keys, ADR-0066 D-K: deploy-check --env refuses a non-empty one). The key list is
# deploy/env/example/<process>.env (generated); deploy-check --env checks presence and placement.
# Values lifted from docs/ops/rehearse.sh start lines unless a line says otherwise; every number: dev-host start
# value, A5 re-measure required (ADR-0066 R-10).
# ADR-0094: total publish-attempt budget including the first (the registry default 3), not lifted from rehearse.sh.
HUMAUX_CONTINUITY_LIST_MERGE_ATTEMPTS=3
# Not lifted from rehearse.sh: the rehearsal runs the daemon at 1-3 s cadences with zero retentions on a throwaway
# database. These are production start values (card 35 table, runbook "Scheduled maintenance").
HUMAUX_MAINTENANCE_SERVE_CYCLE_SECONDS=60
HUMAUX_MAINTENANCE_SERVE_TENANTS_PER_RUN=50
HUMAUX_MAINTENANCE_SERVE_LOST_EVERY_SECONDS=300
HUMAUX_MAINTENANCE_SERVE_LOST_LIMIT=500
# > HUMAUX_GATEWAY_PROJECTION_LAG_SECONDS (the daemon refuses to boot otherwise, ADR-0057 D-F).
HUMAUX_MAINTENANCE_SERVE_LOST_AFTER_SECONDS=900
HUMAUX_MAINTENANCE_SERVE_QUOTA_RESERVATIONS_EVERY_SECONDS=300
HUMAUX_MAINTENANCE_SERVE_QUOTA_RESERVATIONS_LIMIT=500
# ADR-0072 D-C: quota-period renewal. LIMIT = periods staged per tenant call (a year of catch-up after an outage).
HUMAUX_MAINTENANCE_SERVE_QUOTA_RENEWAL_EVERY_SECONDS=300
HUMAUX_MAINTENANCE_SERVE_QUOTA_RENEWAL_LIMIT=12
# 14 days: above the 7-day QuotaWindowRenewalMissing threshold, so a healthy tenant never trips it.
HUMAUX_MAINTENANCE_SERVE_QUOTA_RENEWAL_LEAD_SECONDS=1209600
# ADR-0072 D-B: a renewed subscription_period lasts one month (the §72.1 Free plan's monthly window).
HUMAUX_MAINTENANCE_SERVE_QUOTA_RENEWAL_SUBSCRIPTION_MONTHS=1
HUMAUX_MAINTENANCE_SERVE_PROVIDER_BUDGETS_EVERY_SECONDS=300
HUMAUX_MAINTENANCE_SERVE_PROVIDER_BUDGETS_LIMIT=500
HUMAUX_MAINTENANCE_SERVE_CONFIRM_TOKENS_EVERY_SECONDS=300
HUMAUX_MAINTENANCE_SERVE_CONFIRM_TOKENS_LIMIT=500
# §9 audit: consumed confirm tokens are kept 30 days.
HUMAUX_MAINTENANCE_SERVE_CONFIRM_TOKENS_CONSUMED_RETENTION_SECONDS=2592000
HUMAUX_MAINTENANCE_SERVE_SNAPSHOTS_EVERY_SECONDS=300
HUMAUX_MAINTENANCE_SERVE_SNAPSHOTS_LIMIT=500
HUMAUX_MAINTENANCE_SERVE_JOBS_EVERY_SECONDS=300
HUMAUX_MAINTENANCE_SERVE_JOBS_LIMIT=500
HUMAUX_MAINTENANCE_SERVE_JOBS_DONE_RETENTION_SECONDS=604800
HUMAUX_MAINTENANCE_SERVE_JOBS_DEAD_RETENTION_SECONDS=2592000
HUMAUX_MAINTENANCE_SERVE_REISSUE_EVERY_SECONDS=300
HUMAUX_MAINTENANCE_SERVE_REISSUE_LIMIT=100
HUMAUX_MAINTENANCE_SERVE_REISSUE_COOLDOWN_SECONDS=900
HUMAUX_MAINTENANCE_SERVE_REDRIVE_EVERY_SECONDS=300
HUMAUX_MAINTENANCE_SERVE_REDRIVE_LIMIT=100
HUMAUX_MAINTENANCE_SERVE_REDRIVE_COOLDOWN_SECONDS=900
HUMAUX_MAINTENANCE_SERVE_PARTITIONS_EVERY_SECONDS=3600
HUMAUX_MAINTENANCE_SERVE_DR_EVIDENCE_EVERY_SECONDS=300
# statvfs targets of the dr_evidence task: prod.yml mounts the repository filesystem and the pgdata volume read-only.
HUMAUX_MAINTENANCE_DR_REPO_FS_PATH=/srv/humaux/repo
HUMAUX_MAINTENANCE_DR_PGDATA_FS_PATH=/srv/humaux/pgdata
HUMAUX_MAINTENANCE_SERVE_METRICS_ADDR=127.0.0.1:19108
HUMAUX_MAINTENANCE_HEALTH_SERVE_METRICS_ADDR=127.0.0.1:19107
HUMAUX_MAINTENANCE_HEALTH_SAMPLE_SECONDS=15
# Must equal values/gateway.env (the LOST relation) and values/private-worker.env (the jobs sweep's budget window).
HUMAUX_GATEWAY_PROJECTION_LAG_SECONDS=60
HUMAUX_PRIVATE_WORKER_DISTILL_BUDGET_WINDOW_SECS=60
# Card 37 (runbook 11.x): repository budget 8 GiB, 2 GiB free floor, restore floor 7.5 GiB.
HUMAUX_MAINTENANCE_BACKUP_REPO_MAX_BYTES=8589934592
HUMAUX_MAINTENANCE_BACKUP_MIN_FREE_BYTES=2147483648
HUMAUX_MAINTENANCE_RESTORE_MIN_FREE_DISK_BYTES=8053063680
HUMAUX_MAINTENANCE_DRILL_MIN_FREE_MEMORY_BYTES=1073741824
HUMAUX_MAINTENANCE_DRILL_RESTORE_TIMEOUT_SECONDS=1800
HUMAUX_MAINTENANCE_EMBEDDING_DIMENSION=1024
HUMAUX_MAINTENANCE_PRIVATE_MEMORY_COLLECTION=humaux_private_memory_v1
HUMAUX_MAINTENANCE_QDRANT_PORT=6333
# The restore drill's rebuild reads the retrieval worker's names (embedding version, scanner pin; runbook 11.x).
HUMAUX_RETRIEVAL_WORKER_EMBEDDING_VERSION=text-embedding-v4@2026-08
HUMAUX_RETRIEVAL_WORKER_GITLEAKS_BIN=/usr/local/bin/gitleaks
HUMAUX_RETRIEVAL_WORKER_GITLEAKS_VERSION=v8.30.1
# TODO-main-line (S8): the same sha256 as values/retrieval-worker.env.
HUMAUX_RETRIEVAL_WORKER_GITLEAKS_SHA256=db4d43dd4ab54f047a2d18d210a8d2294e2e5cc26d1e26a299a9675916f5647d
