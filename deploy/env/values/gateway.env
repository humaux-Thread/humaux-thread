# deploy/env/values/gateway.env — service: gateway.
# Non-secret BUNDLE CONSTANTS (identical on every node), loaded by deploy/compose/prod.yml as the first env_file of
# the service(s) below (ADR-0066 D-C, D-J). Never here: a DSN, password, key, pepper or credential map (those are in
# $HUMAUX_SECRETS_DIR/<process>.secret.env, 0600, outside git, written by deploy/release/render-secrets.sh); a node
# value (cell id, egress processor id, addresses, paths: prod.yml `environment:` from node.env); a DEV_ONLY_KEYS entry
# (the dev-only same-uid allowance keys, ADR-0066 D-K: deploy-check --env refuses a non-empty one). The key list is
# deploy/env/example/<process>.env (generated); deploy-check --env checks presence and placement.
# Values lifted from docs/ops/rehearse.sh start lines unless a line says otherwise; every number: dev-host start
# value, A5 re-measure required (ADR-0066 R-10).
# ADR-0094: total publish-attempt budget including the first (the registry default 3), not lifted from rehearse.sh.
HUMAUX_CONTINUITY_LIST_MERGE_ATTEMPTS=3
HUMAUX_GATEWAY_ADMISSION_BODY_READ_TIMEOUT_MS=5000
# ADR-0065 D-C admission start values C 16 / Q 64 / W 5 s / K = C / 2.
HUMAUX_GATEWAY_ADMISSION_CONCURRENCY=16
HUMAUX_GATEWAY_ADMISSION_MAX_WAIT_MS=5000
HUMAUX_GATEWAY_ADMISSION_PER_KEY_LIMIT=8
HUMAUX_GATEWAY_ADMISSION_QUEUE_DEPTH=64
# M02 D3: off until the owner provisions HUMAUX_GATEWAY_AUTH_HMAC_KEY in gateway.secret.env; deploy-check --env then
# requires that key.
HUMAUX_GATEWAY_AUTH_SURFACE_ENABLED=false
# M12 D5 (Baseline §51, ADR-0076) query-embedding cache: the design's start sizes (256 MiB / 16 MiB / 24 h); the B23
# load test sets the deployed values. Off until the generation stamp below is filled in.
HUMAUX_GATEWAY_CACHE_EMBED_QUERY_BYTES=268435456
HUMAUX_GATEWAY_CACHE_EMBED_QUERY_ENABLED=true
HUMAUX_GATEWAY_CACHE_EMBED_QUERY_TTL_SECONDS=86400
HUMAUX_GATEWAY_CACHE_PER_TENANT_BYTES=16777216
HUMAUX_GATEWAY_CALLER_ID=gateway
HUMAUX_GATEWAY_CONFIRM_TOKEN_TTL_SECONDS=300
HUMAUX_GATEWAY_CONTEXT_MANDATORY_TOKENS=1024
HUMAUX_GATEWAY_CONTEXT_TOTAL_TOKENS=2048
# M02 D8 (§78.1): the least seconds between two last_used_at writes of one API key; the registered default. Every
# request still reads and validates the key.
HUMAUX_GATEWAY_CREDENTIAL_TOUCH_INTERVAL_SECONDS=60
# §19 frozen embedding: text-embedding-v4 / 1024 / revision 2026-08.
HUMAUX_GATEWAY_EMBEDDING_DIMENSION=1024
# M12 D4: the generation stamp the query-embedding cache admits = the retrieval worker's
# HUMAUX_RETRIEVAL_WORKER_{EMBEDDING_PROVIDER,EMBEDDING_MODEL,MODEL_REVISION} (one identity written twice; bootstrap.rs
# test the_gateway_embedding_stamp_equals_the_workers_identity_in_the_values_files keeps them equal).
HUMAUX_GATEWAY_EMBEDDING_MODEL_ID=text-embedding-v4
HUMAUX_GATEWAY_EMBEDDING_MODEL_REVISION=2026-08
HUMAUX_GATEWAY_EMBEDDING_PROVIDER_ID=dashscope
HUMAUX_GATEWAY_EMBEDDING_VERSION=text-embedding-v4@2026-08
HUMAUX_GATEWAY_ENUMERATION_MANIFEST_CAP=1000
HUMAUX_GATEWAY_ENUMERATION_TTL_SECONDS=900
HUMAUX_GATEWAY_FINALIZE_TIMEOUT_SECONDS=5
HUMAUX_GATEWAY_GLOBAL_DENYLIST=
HUMAUX_GATEWAY_GLOBAL_EMERGENCY_ALLOWLIST=
HUMAUX_GATEWAY_HANDLER_TIMEOUT_SECONDS=20
HUMAUX_GATEWAY_MAX_FORWARDED_HOPS=1
HUMAUX_GATEWAY_MAX_REQUEST_BODY_BYTES=1048576
# ADR-0061 D-B: ops listeners are loopback-only; in the shared network namespace (D-F) 19101-19108 as on a host.
HUMAUX_GATEWAY_METRICS_ADDR=127.0.0.1:19101
HUMAUX_GATEWAY_MOOD_HALF_LIFE_SECONDS=21600
# ADR-0065 D-A: P = C*k + 2 + H = 18 (counted in max_connections, deploy/postgres/sizing-*.conf).
HUMAUX_GATEWAY_PG_ACQUIRE_TIMEOUT_MS=1000
HUMAUX_GATEWAY_PG_IDLE_IN_TRANSACTION_TIMEOUT_MS=10000
HUMAUX_GATEWAY_PG_IDLE_TIMEOUT_SECONDS=300
HUMAUX_GATEWAY_PG_MAX_LIFETIME_SECONDS=1800
HUMAUX_GATEWAY_PG_POOL_MAX_CONNECTIONS=18
HUMAUX_GATEWAY_PG_POOL_MIN_CONNECTIONS=2
HUMAUX_GATEWAY_PG_STATEMENT_TIMEOUT_MS=10000
# Not the rehearsal's 20 s test window. Must equal HUMAUX_GATEWAY_PROJECTION_LAG_SECONDS of values/maintenance.env.
HUMAUX_GATEWAY_PROJECTION_LAG_SECONDS=60
HUMAUX_GATEWAY_QDRANT_PORT=6333
HUMAUX_GATEWAY_QDRANT_TLS=false
HUMAUX_GATEWAY_RATE_LOCK_TIMEOUT_MS=2000
HUMAUX_GATEWAY_RATE_PREAUTH_IPV6_PREFIX_BITS=64
# ADR-0100: registered B23/X-RATE start values below, not rehearse.sh.
HUMAUX_GATEWAY_RATE_PREAUTH_IP_CAPACITY=256
HUMAUX_GATEWAY_RATE_PREAUTH_IP_REFILL_PER_SECOND=128
HUMAUX_GATEWAY_RATE_CREDENTIAL_CAPACITY=64
HUMAUX_GATEWAY_RATE_CREDENTIAL_REFILL_PER_SECOND=20
HUMAUX_GATEWAY_RATE_USER_CAPACITY=128
HUMAUX_GATEWAY_RATE_USER_REFILL_PER_SECOND=20
HUMAUX_GATEWAY_RATE_TENANT_CAPACITY=128
HUMAUX_GATEWAY_RATE_TENANT_REFILL_PER_SECOND=20
HUMAUX_GATEWAY_RATE_OPERATION_CAPACITY=64
HUMAUX_GATEWAY_RATE_OPERATION_REFILL_PER_SECOND=20
HUMAUX_GATEWAY_READINESS_REFRESH_SECONDS=2
HUMAUX_GATEWAY_REMEMBER_DATA_CLASS=INTERNAL
# The §15.1 ticket family (domain::ticket_family::TicketFamily::PrivateMemory).
HUMAUX_GATEWAY_REMEMBER_DOMAIN=private_memory
HUMAUX_GATEWAY_REMEMBER_EVENT_KIND=USER_MESSAGE
HUMAUX_GATEWAY_REMEMBER_PROJECTION_KIND=PRIVATE_MEMORY
HUMAUX_GATEWAY_REMEMBER_PROJECTION_VERSION=v1
HUMAUX_GATEWAY_REMEMBER_SCOPE_KIND=workspace
# ADR-0054 D-D: the former default write pair, unused; declared empty so deploy-check --env sees every key.
HUMAUX_GATEWAY_REMEMBER_TENANT_ID=
HUMAUX_GATEWAY_REMEMBER_TOKEN_TTL_SECONDS=60
HUMAUX_GATEWAY_REMEMBER_VISIBILITY_CLASS=WORKSPACE_SHARED
HUMAUX_GATEWAY_REMEMBER_WORKSPACE_ID=
HUMAUX_GATEWAY_REPLAY_TTL_SECONDS=60
# ADR-0084 D-E: the rerank lane's model pin, the identity the gateway compares each worker reply with. Read only while the
# profile's rerank_enabled is true (it is false until the artifact is deployed and U2 is read); then all five are
# required. They must equal the HUMAUX_RETRIEVAL_WORKER_RERANK_* identity values of values/retrieval-worker.env (a unit
# test of the gateway bootstrap compares the two files).
HUMAUX_GATEWAY_RERANK_MODEL_SHA256=b924df3444fb4fe511152c89ec312fa73b44b901c115456405da54503b4e7edf
HUMAUX_GATEWAY_RERANK_RECIPE=mmarco-int8-v1
HUMAUX_GATEWAY_RERANK_REPO=cross-encoder/mmarco-mMiniLMv2-L12-H384-v1
HUMAUX_GATEWAY_RERANK_REVISION=1427fd652930e4ba29e8149678df786c240d8825
HUMAUX_GATEWAY_RERANK_TOKENIZER_SHA256=62c24cdc13d4c9952d63718d6c9fa4c287974249e16b7ade6d5a85e7bbb75626
HUMAUX_GATEWAY_RESERVATION_TTL_SECONDS=30
HUMAUX_GATEWAY_RETRIEVAL_RPC_PERMIT_TTL_SECONDS=60
# ADR-0066 D-L: the retrieval RPC server's uid (prod.yml retrieval-rpc user 10102); deploy-check cross-checks it.
HUMAUX_GATEWAY_RETRIEVAL_RPC_SERVER_UID=10102
HUMAUX_GATEWAY_RETRIEVAL_RPC_SOCKET_PATH=/run/humaux/sock-retrieval/retrieval.sock
# §30.2 coord task-run lease (M29 T04a): the registered default.
HUMAUX_GATEWAY_TASK_LEASE_TTL_SECONDS=300
HUMAUX_GATEWAY_TRUSTED_PROXY_CIDRS=
HUMAUX_GATEWAY_UNDO_WINDOW_SECONDS=86400

# ADR-0100: B23/X-RATE start values from the registered limiter policy; not rehearse.sh.
HUMAUX_GATEWAY_RATE_PREAUTH_IP_MAX_SUBJECTS=10000
HUMAUX_GATEWAY_RATE_CREDENTIAL_MAX_SUBJECTS=10000
HUMAUX_GATEWAY_RATE_USER_MAX_SUBJECTS=10000
HUMAUX_GATEWAY_RATE_TENANT_MAX_SUBJECTS=10000
HUMAUX_GATEWAY_RATE_OPERATION_MAX_SUBJECTS=10000
HUMAUX_GATEWAY_DEPLOYMENT=default
HUMAUX_GATEWAY_SESSION_LOCK_CHECK_SECONDS=5
# ADR-0100: fail closed if the heartbeat cannot complete within this bound.
HUMAUX_GATEWAY_SESSION_LOCK_TIMEOUT_SECONDS=2
