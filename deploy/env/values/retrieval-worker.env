# deploy/env/values/retrieval-worker.env — services: retrieval-rpc (--serve-rpc), retrieval-serve (--serve).
# Non-secret BUNDLE CONSTANTS (identical on every node), loaded by deploy/compose/prod.yml as the first env_file of
# the service(s) below (ADR-0066 D-C, D-J). Never here: a DSN, password, key, pepper or credential map (those are in
# $HUMAUX_SECRETS_DIR/<process>.secret.env, 0600, outside git, written by deploy/release/render-secrets.sh); a node
# value (cell id, egress processor id, addresses, paths: prod.yml `environment:` from node.env); a DEV_ONLY_KEYS entry
# (the dev-only same-uid allowance keys, ADR-0066 D-K: deploy-check --env refuses a non-empty one). The key list is
# deploy/env/example/<process>.env (generated); deploy-check --env checks presence and placement.
# Values lifted from docs/ops/rehearse.sh start lines unless a line says otherwise; every number: dev-host start
# value, A5 re-measure required (ADR-0066 R-10).
HUMAUX_RETRIEVAL_WORKER_BACKOFF_BASE_SECS=30
HUMAUX_RETRIEVAL_WORKER_BACKOFF_MAX_SECS=300
HUMAUX_RETRIEVAL_WORKER_BATCH=16
HUMAUX_RETRIEVAL_WORKER_CALLER=retrieval-worker
# §19 frozen embedding: DashScope text-embedding-v4 / 1024 / revision 2026-08 / cn-beijing / 8192 input tokens.
HUMAUX_RETRIEVAL_WORKER_DIMENSION=1024
# ADR-0068 D-F: text-embedding-v4's documented per-request input cap (DashScope batch API: 10).
HUMAUX_RETRIEVAL_WORKER_EMBEDDING_MAX_BATCH_ITEMS=10
HUMAUX_RETRIEVAL_WORKER_EMBEDDING_MODEL=text-embedding-v4
HUMAUX_RETRIEVAL_WORKER_EMBEDDING_PROVIDER=dashscope
HUMAUX_RETRIEVAL_WORKER_EMBEDDING_VERSION=text-embedding-v4@2026-08
HUMAUX_RETRIEVAL_WORKER_MAX_INPUT_TOKENS=8192
HUMAUX_RETRIEVAL_WORKER_MODEL_REVISION=2026-08
HUMAUX_RETRIEVAL_WORKER_REGION=cn-beijing
# ADR-0066 D-K: the gateway's uid (prod.yml gateway user 10101); deploy-check cross-checks it.
HUMAUX_RETRIEVAL_WORKER_GATEWAY_UID=10101
# The scanner pin: deploy/images/humaux/Dockerfile copies gitleaks 8.30.1 from the digest-pinned image to this path.
HUMAUX_RETRIEVAL_WORKER_GITLEAKS_BIN=/usr/local/bin/gitleaks
HUMAUX_RETRIEVAL_WORKER_GITLEAKS_VERSION=v8.30.1
# TODO-main-line (S8): sha256 of /usr/bin/gitleaks in zricethezav/gitleaks:v8.30.1@sha256:c00b6bd0… (linux/arm64),
# read once with `docker run --rm --entrypoint sha256sum <that ref> /usr/bin/gitleaks`. Empty = the worker refuses
# boot (exit 2, the runbook's verify step stops); deploy-check --env sees the key declared and cannot tell a required
# empty from an empty-by-design one (ADR-0066 L-17), so this line must be filled before R1.
HUMAUX_RETRIEVAL_WORKER_GITLEAKS_SHA256=db4d43dd4ab54f047a2d18d210a8d2294e2e5cc26d1e26a299a9675916f5647d
HUMAUX_RETRIEVAL_WORKER_LEASE_SECS=60
HUMAUX_RETRIEVAL_WORKER_MAX_ATTEMPTS=6
HUMAUX_RETRIEVAL_WORKER_PER_TENANT_CAP=8
HUMAUX_RETRIEVAL_WORKER_POLL_INTERVAL_SECS=1
HUMAUX_RETRIEVAL_WORKER_QDRANT_PORT=6333
HUMAUX_RETRIEVAL_WORKER_QDRANT_TLS=false
HUMAUX_RETRIEVAL_WORKER_RPC_SOCKET_PATH=/run/humaux/sock-retrieval/retrieval.sock
HUMAUX_RETRIEVAL_WORKER_SERVE_METRICS_ADDR=127.0.0.1:19103
HUMAUX_RETRIEVAL_WORKER_SERVE_RPC_METRICS_ADDR=127.0.0.1:19102
