# deploy/env/values/private-worker.env — services: private-rpc (--serve-rpc), private-distill (--distill-serve; prod.yml
# gives it its own socket file in the same volume through `environment:`).
# The provider route keys (CREDENTIALS, DNS_PINS, EGRESS_RECIPIENTS, REGIONS) are per node and per provider: they are
# in private-worker.secret.env beside the provider key (runbook §O-DNS edits the pins there, ADR-0066 D-P).
# Non-secret BUNDLE CONSTANTS (identical on every node), loaded by deploy/compose/prod.yml as the first env_file of
# the service(s) below (ADR-0066 D-C, D-J). Never here: a DSN, password, key, pepper or credential map (those are in
# $HUMAUX_SECRETS_DIR/<process>.secret.env, 0600, outside git, written by deploy/release/render-secrets.sh); a node
# value (cell id, egress processor id, addresses, paths: prod.yml `environment:` from node.env); a DEV_ONLY_KEYS entry
# (the dev-only same-uid allowance keys, ADR-0066 D-K: deploy-check --env refuses a non-empty one). The key list is
# deploy/env/example/<process>.env (generated); deploy-check --env checks presence and placement.
# Values lifted from docs/ops/rehearse.sh start lines unless a line says otherwise; every number: dev-host start
# value, A5 re-measure required (ADR-0066 R-10).
HUMAUX_PRIVATE_WORKER_CANDIDATE_TTL_SECONDS=86400
# ADR-0066 D-K: the consolidation worker's uid (prod.yml consolidation user 10104); deploy-check cross-checks it.
HUMAUX_PRIVATE_WORKER_CONSOLIDATION_UID=10104
HUMAUX_PRIVATE_WORKER_DISTILL_BUDGET_MAX_CALLS=120
# Must equal HUMAUX_PRIVATE_WORKER_DISTILL_BUDGET_WINDOW_SECS of values/maintenance.env (the jobs sweep's window).
HUMAUX_PRIVATE_WORKER_DISTILL_BUDGET_WINDOW_SECS=60
HUMAUX_PRIVATE_WORKER_DISTILL_HARD_DEADLINE_SECS=300
# §67.2 private reasoning concurrency 4.
HUMAUX_PRIVATE_WORKER_DISTILL_IN_FLIGHT=4
HUMAUX_PRIVATE_WORKER_DISTILL_LEASE_SECS=30
HUMAUX_PRIVATE_WORKER_DISTILL_MAX_ATTEMPTS=5
HUMAUX_PRIVATE_WORKER_DISTILL_NOT_READY_PARK_SECS=600
HUMAUX_PRIVATE_WORKER_DISTILL_POLL_INTERVAL_SECS=3
HUMAUX_PRIVATE_WORKER_DISTILL_SERVE_METRICS_ADDR=127.0.0.1:19105
HUMAUX_PRIVATE_WORKER_HEALTH_RENEW_SECS=1800
HUMAUX_PRIVATE_WORKER_HTTP_TIMEOUT_SECS=120
HUMAUX_PRIVATE_WORKER_PERMIT_TTL_SECS=60
HUMAUX_PRIVATE_WORKER_RPC_SOCKET_PATH=/run/humaux/sock-inference/inference.sock
HUMAUX_PRIVATE_WORKER_SERVE_RPC_METRICS_ADDR=127.0.0.1:19104
