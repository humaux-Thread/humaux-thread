# deploy/env/values/admin.env — service: admin (profile ops, one-shot read-only CLI).
# Non-secret BUNDLE CONSTANTS (identical on every node), loaded by deploy/compose/prod.yml as the first env_file of
# the service(s) below (ADR-0066 D-C, D-J). Never here: a DSN, password, key, pepper or credential map (those are in
# $HUMAUX_SECRETS_DIR/<process>.secret.env, 0600, outside git, written by deploy/release/render-secrets.sh); a node
# value (cell id, egress processor id, addresses, paths: prod.yml `environment:` from node.env); a DEV_ONLY_KEYS entry
# (the dev-only same-uid allowance keys, ADR-0066 D-K: deploy-check --env refuses a non-empty one). The key list is
# deploy/env/example/<process>.env (generated); deploy-check --env checks presence and placement.
# Values lifted from docs/ops/rehearse.sh start lines unless a line says otherwise; every number: dev-host start
# value, A5 re-measure required (ADR-0066 R-10).
# The eight ops listeners of the shared network namespace (ADR-0066 D-F), name=host:port.
HUMAUX_ADMIN_OPS_ADDRS=gateway=127.0.0.1:19101,retrieval-rpc=127.0.0.1:19102,retrieval-serve=127.0.0.1:19103,private-rpc=127.0.0.1:19104,private-distill=127.0.0.1:19105,consolidation=127.0.0.1:19106,maintenance-health=127.0.0.1:19107,maintenance-serve=127.0.0.1:19108
HUMAUX_ADMIN_PRIVATE_INFERENCE_RPC_SOCKET_PATH=/run/humaux/sock-inference/inference.sock
HUMAUX_ADMIN_RETRIEVAL_RPC_SOCKET_PATH=/run/humaux/sock-retrieval/retrieval.sock
# The gateway is published on 127.0.0.1 only; TLS is card 53 (ADR-0066 E-10 / L-12): no certificate to watch yet.
HUMAUX_ADMIN_TLS_CERT_PATHS=
HUMAUX_CELL_CALLER_ID=admin
HUMAUX_QDRANT_PORT=6333
HUMAUX_QDRANT_TLS=false
